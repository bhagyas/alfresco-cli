{
  "compilerOptions": {
    "outDir": "./bin",
    "allowJs": false,
    "target": "es2015",
    "lib": [
      "es2015"
    ],
    "types": [
      "node",
      "jest"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}